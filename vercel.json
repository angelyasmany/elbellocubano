{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/facebook.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "rewrites": [
    { "source": "/datos/seguidores", "destination": "/api/facebook" },
    { "source": "/api/social-counts", "destination": "/api/facebook" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "elbellocubano.vercel.app"
        }
      ],
      "destination": "https://elbellocubano.com/:path*",
      "permanent": true
    }
  ]
}
