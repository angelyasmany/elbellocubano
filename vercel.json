{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/contadores.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/followers",
      "destination": "/api/contadores?network=tiktok"
    },
    {
      "source": "/api/instagram",
      "destination": "/api/contadores?network=instagram"
    },
    {
      "source": "/api/facebook",
      "destination": "/api/contadores?network=facebook"
    },
    {
      "source": "/api/youtube",
      "destination": "/api/contadores?network=youtube"
    }
  ]
}
